SPINDLE_HOME=~/.spindle
SPINDLE_AGENT=work-agent
SPINDLE_SOURCE=fixtures            # fixtures | gmail
SPINDLE_APPROVAL_TIMEOUT=45
SPINDLE_DASHBOARD_PORT=8765

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:2b               # or the Muse Spark Open tag once verified
LLM_API_KEY=ollama                 # Ollama ignores it; for cloud Muse use the real key
LLM_TIMEOUT=20
LLM_ENABLED=true                   # false = rules only (classify unknown as other/high)

ANTHROPIC_API_KEY=
SPINDLE_CLAUDE_MODEL=claude-opus-5-5
