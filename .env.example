SPINDLE_HOME=~/.spindle
SPINDLE_AGENT=work-agent
SPINDLE_SOURCE=fixtures            # fixtures | gmail
SPINDLE_APPROVAL_TIMEOUT=45
SPINDLE_DASHBOARD_PORT=8765

# Local (default; email never leaves your machine)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:2b
LLM_API_KEY=ollama
# Cloud Meta Muse (development only; email text is strict-redacted before sending)
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_MODEL=muse-spark-1.3
# LLM_API_KEY=<your key>
LLM_TIMEOUT=20
LLM_ENABLED=true                   # false = rules only (classify unknown as other/high)

ANTHROPIC_API_KEY=
SPINDLE_CLAUDE_MODEL=claude-opus-5-5
